{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NekoPapa",
  "version": "0.1.0",
  "identifier": "app.nekopapa.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NekoPapa",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "backgroundColor": "#ffffff",
        "theme": "Light",
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/nekopapa-v1/32x32.png", "icons/nekopapa-v1/128x128.png", "icons/nekopapa-v1/128x128@2x.png", "icons/nekopapa-v1/icon.icns", "icons/nekopapa-v1/icon.ico"]
  }
}
