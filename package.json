{
  "name": "nekopapa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NekoPapa desktop workspace",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "desktop": "npm run desktop:build:local && open -n \"$PWD/src-tauri/target/release/bundle/macos/NekoPapa.app\"",
    "desktop:build": "tauri build",
    "desktop:build:local": "APPLE_SIGNING_IDENTITY=${APPLE_SIGNING_IDENTITY:--} NEKOPAPA_ACCOUNT_API_URL=http://127.0.0.1:8080 NEKOPAPA_BUILD_NUMBER=1 NEKOPAPA_RELEASE_CHANNEL=dev tauri build --bundles app",
    "desktop:build:distribution": "node scripts/build-distribution.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.98",
    "@ai-sdk/google": "^4.0.113",
    "@ai-sdk/openai": "^4.0.110",
    "@ai-sdk/openai-compatible": "3.0.80",
    "@ai-sdk/react": "^4.0.168",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "ai": "^7.0.164",
    "katex": "0.19.1",
    "lucide-react": "1.61.0",
    "mermaid": "12.3.0",
    "motion": "^12.43.0",
    "qrcode.react": "4.2.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "shiki": "4.6.0",
    "tailwind-merge": "^3.7.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "2.12.1",
    "@types/json-schema": "^7.0.15",
    "@types/node": "25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "type-fest": "4.41.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "overrides": {
    "katex": "$katex"
  }
}
